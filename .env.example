OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local mode (default model must already be installed in Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=nemotron-3-nano:4b

# Add only the exact HTTPS origin assigned by Vercel, then restart the backend.
# Example: http://127.0.0.1:8002,http://localhost:8002,https://YOUR-PROJECT.vercel.app
RESEARCH_ALLOWED_ORIGINS=http://127.0.0.1:8002,http://localhost:8002
